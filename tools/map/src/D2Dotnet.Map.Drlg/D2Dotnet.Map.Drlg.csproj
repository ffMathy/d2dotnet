<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2Dotnet.Map.Drlg</RootNamespace>
    <Description>Pure C# Diablo II level generator (DRLG), ported from libd2.</Description>
    <!-- The engine-transform core (Engine/) mirrors libd2's pointer-faithful port of the
         1.14d DRLG, including its pointer punning, so it runs on unsafe structs in native memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/D2Dotnet/D2Dotnet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="D2Dotnet.Map.Drlg.Tests" />
  </ItemGroup>
</Project>
