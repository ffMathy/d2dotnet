<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/D2Dotnet.Map.Drlg/D2Dotnet.Map.Drlg.csproj" />
    <!-- The libd2 native generator (oracle). Test-only; pinned. -->
    <PackageReference Include="LibD2" Version="0.1.1" />
  </ItemGroup>

  <!--
    libd2 test fixtures (excel tables, baked DS1/DT1 blobs, raw .ds1/.dt1 files). These are
    Blizzard-derived and are NEVER committed: they are downloaded at build time into
    <repo root>/.cache/libd2/ (gitignored) from the pinned libd2 commit. A failed download does
    not break the build; the tests that need the fixtures then fail with a clear message.
  -->
  <PropertyGroup>
    <LibD2Commit>00004e6383890d895507ab4d12dfbb1a857c3bdf</LibD2Commit>
    <LibD2Url>https://codeload.github.com/jaenster/libd2/tar.gz/$(LibD2Commit)</LibD2Url>
    <D2RepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), D2Dotnet.slnx))</D2RepoRoot>
    <LibD2CacheDir>$(D2RepoRoot)/.cache/libd2</LibD2CacheDir>
    <LibD2Tarball>$(LibD2CacheDir)/libd2-$(LibD2Commit).tar.gz</LibD2Tarball>
    <LibD2SourceDir>$(LibD2CacheDir)/libd2-$(LibD2Commit)</LibD2SourceDir>
    <LibD2Marker>$(LibD2SourceDir)/.extracted</LibD2Marker>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LibD2SourceDir</_Parameter1>
      <_Parameter2>$(LibD2SourceDir)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LibD2Url</_Parameter1>
      <_Parameter2>$(LibD2Url)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="FetchLibD2Fixtures" BeforeTargets="CoreCompile" Condition="!Exists('$(LibD2Marker)')">
    <MakeDir Directories="$(LibD2CacheDir)" />
    <Message Importance="high" Condition="!Exists('$(LibD2Tarball)')" Text="Downloading libd2 test fixtures from $(LibD2Url) ..." />
    <Exec Condition="!Exists('$(LibD2Tarball)')"
          Command="curl -fsSL --retry 2 -o &quot;$(LibD2Tarball).part&quot; &quot;$(LibD2Url)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardErrorImportance="low" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_LibD2CurlExit" />
    </Exec>
    <Copy Condition="'$(_LibD2CurlExit)' == '0'" SourceFiles="$(LibD2Tarball).part" DestinationFiles="$(LibD2Tarball)" />
    <Delete Files="$(LibD2Tarball).part" />
    <Exec Condition="Exists('$(LibD2Tarball)')"
          Command="tar -xzf &quot;$(LibD2Tarball)&quot; -C &quot;$(LibD2CacheDir)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_LibD2TarExit" />
    </Exec>
    <Touch Condition="'$(_LibD2TarExit)' == '0' And Exists('$(LibD2SourceDir)')" Files="$(LibD2Marker)" AlwaysCreate="true" />
    <Message Importance="high" Condition="!Exists('$(LibD2Marker)')"
             Text="libd2 test fixtures are NOT available (download of $(LibD2Url) or extraction failed); the fixture tests will fail." />
  </Target>
</Project>
