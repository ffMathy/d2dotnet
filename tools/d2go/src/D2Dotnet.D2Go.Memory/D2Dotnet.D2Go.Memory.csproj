<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>D2Dotnet.D2Go.Memory</RootNamespace>
    <Description>Port of d2go's pkg/memory and pkg/utils: reads the game state of a running Diablo II: Resurrected process into the D2Dotnet.D2Go.Data model.</Description>
    <!-- LibraryImport (source-generated P/Invoke) of the Windows process reader needs unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../D2Dotnet.D2Go.Data/D2Dotnet.D2Go.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="D2Dotnet.D2Go.Memory.Tests" />
  </ItemGroup>
</Project>
