<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>D2Dotnet</AssemblyName>
    <RootNamespace>D2Dotnet</RootNamespace>
    <Description>Diablo II: Resurrected for .NET: game file access (CASC or extracted folders), the excel tables and string tables, the shared ids, the map generator, and the snapshot of a running game read from its memory.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The map generator's engine (Maps/Engine) mirrors libd2's pointer-faithful port of the 1.14d DRLG, including its
         pointer punning, so it runs on unsafe structs in native memory; LibraryImport (source-generated P/Invoke) of
         WindowsProcessMemory passes pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2Dotnet.Tests" />
  </ItemGroup>

  <!-- The licences of the ported code (see THIRD-PARTY-NOTICES.md) ship in the package next to the assembly that
       contains it. -->
  <ItemGroup>
    <None Include="Maps/LICENSE-libd2" Pack="true" PackagePath="" />
    <None Include="Memory/LICENSE-d2go" Pack="true" PackagePath="" />
    <None Include="Files/Casc/LICENSE-CascLib" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
